# Copy this file to `deploy/.env` and adjust values. Never commit the real
# `.env` file (it is gitignored). No secrets are set below — generate your
# own for POSTGRES_PASSWORD before running in anything but a throwaway
# local sandbox.

# --- Postgres ---
POSTGRES_USER=vocadox
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vocadox
POSTGRES_PORT=5432

# --- Valkey ---
VALKEY_PORT=6379

# --- Backend ---
VOCADOX_ENVIRONMENT=development
VOCADOX_LOG_LEVEL=INFO
VOCADOX_LOG_FORMAT=json
VOCADOX_DATABASE_URL=postgresql+asyncpg://vocadox:changeme@postgres:5432/vocadox
VOCADOX_VALKEY_URL=valkey://valkey:6379/0
VOCADOX_CORS_ALLOW_ORIGINS=["http://localhost:5173"]
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173

# --- Media / conversation capture (Phase 2) ---
# See docs/admin/media-storage.md for full descriptions.
VOCADOX_MEDIA_STORAGE_ROOT=./data/media
VOCADOX_UPLOAD_TEMP_DIR=./data/tmp-uploads
VOCADOX_MAX_UPLOAD_SIZE_BYTES=2147483648
VOCADOX_UPLOAD_TIMEOUT_SECONDS=600
VOCADOX_MAX_ACTIVE_UPLOAD_SESSIONS_PER_USER=5
VOCADOX_RECORDING_CONSENT_NOTICE="Confirm that required consent/authorization for this recording has been obtained."
# Unset (default) means "keep indefinitely" — see docs/admin/retention.md.
# VOCADOX_DEFAULT_RETENTION_POLICY_NAME=

# --- Speech-to-text / diarization (Phase 3) ---
# See docs/admin/model-installation.md and docs/admin/diarization-provider.md.
# Both default to "fake" (deterministic, no model/GPU required) so
# `docker compose up` never silently tries to load an uninstalled model.
# Set to real values only AFTER installing the corresponding model via
# `docker compose run --rm model-manager install <profile>`.
# VOCADOX_SPEECH_PROVIDER=faster_whisper
# VOCADOX_DIARIZATION_PROVIDER=pyannote
# VOCADOX_SPEECH_DEVICE=auto
# VOCADOX_DIARIZATION_DEVICE=auto
#
# Hugging Face access token — ONLY needed for the one-time
# `model-manager install diarization-default` step (the diarization
# pipeline and its two dependent sub-models are gated on Hugging Face);
# never read by the running worker at request time, never logged. Do not
# commit a real value — this file is `.env.example`, meant to stay a
# template. See docs/security/model-supply-chain.md.
# VOCADOX_HUGGINGFACE_TOKEN=

# --- LLM / fact extraction (Phase 4) ---
# See docs/admin/llm-provider.md. Defaults to "fake" (deterministic, no
# model/GPU/Ollama server required) so `docker compose up` never silently
# requires a running Ollama instance. Set to "ollama" only AFTER pulling
# the model: `docker compose exec ollama ollama pull qwen2.5:14b`.
# VOCADOX_LLM_PROVIDER=ollama
# VOCADOX_LLM_BASE_URL=http://ollama:11434
# VOCADOX_LLM_MODEL=qwen2.5:14b
# VOCADOX_LLM_CONTEXT_LENGTH=32768
# VOCADOX_LLM_MAX_TOKENS=2048
# OLLAMA_PORT=11434
