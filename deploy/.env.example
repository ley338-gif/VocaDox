# Copy this file to `deploy/.env` and adjust values. Never commit the real
# `.env` file (it is gitignored). No secrets are set below — generate your
# own for POSTGRES_PASSWORD before running in anything but a throwaway
# local sandbox.

# --- Postgres ---
POSTGRES_USER=vocadox
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vocadox
POSTGRES_PORT=5432

# --- Valkey ---
VALKEY_PORT=6379

# --- Backend ---
VOCADOX_ENVIRONMENT=development
VOCADOX_LOG_LEVEL=INFO
VOCADOX_LOG_FORMAT=json
VOCADOX_DATABASE_URL=postgresql+asyncpg://vocadox:changeme@postgres:5432/vocadox
VOCADOX_VALKEY_URL=valkey://valkey:6379/0
VOCADOX_CORS_ALLOW_ORIGINS=["http://localhost:5173"]
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=5173

# --- Media / conversation capture (Phase 2) ---
# See docs/admin/media-storage.md for full descriptions.
VOCADOX_MEDIA_STORAGE_ROOT=./data/media
VOCADOX_UPLOAD_TEMP_DIR=./data/tmp-uploads
VOCADOX_MAX_UPLOAD_SIZE_BYTES=2147483648
VOCADOX_UPLOAD_TIMEOUT_SECONDS=600
VOCADOX_MAX_ACTIVE_UPLOAD_SESSIONS_PER_USER=5
VOCADOX_RECORDING_CONSENT_NOTICE="Confirm that required consent/authorization for this recording has been obtained."
# Unset (default) means "keep indefinitely" — see docs/admin/retention.md.
# VOCADOX_DEFAULT_RETENTION_POLICY_NAME=
