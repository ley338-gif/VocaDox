# Copy to a protected file outside version control, fill every required value,
# and use it with: docker compose --env-file <file> -f deploy/compose.prod.yml ...

POSTGRES_USER=vocadox
POSTGRES_PASSWORD=
POSTGRES_DB=vocadox

# Absolute host directory on separate/off-host-backed storage. The application
# writes pg_dump and media archive artifacts here.
VOCADOX_BACKUP_PATH=

# Absolute host paths to a certificate chain and matching private key.
VOCADOX_TLS_CERTIFICATE_PATH=
VOCADOX_TLS_PRIVATE_KEY_PATH=

VOCADOX_LOG_LEVEL=INFO
VOCADOX_LOG_FORMAT=json
# Same-origin is safest and needs no CORS entries. JSON array of explicit HTTPS
# origins only, for example ["https://trusted-client.example"].
VOCADOX_PRODUCTION_CORS_ALLOW_ORIGINS=[]

# Deterministic providers are safe for initial installation. Configure local
# production providers only after their models/services are installed.
VOCADOX_SPEECH_PROVIDER=fake
VOCADOX_SPEECH_DEVICE=auto
VOCADOX_DIARIZATION_PROVIDER=fake
VOCADOX_DIARIZATION_DEVICE=auto
VOCADOX_LLM_PROVIDER=fake
VOCADOX_LLM_BASE_URL=
VOCADOX_LLM_MODEL=qwen2.5:14b
